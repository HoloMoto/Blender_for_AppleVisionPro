+static void ghost_ios_bind_ghost_window_to_swiftui_scene(GHOST_WindowIOS *win)
+{
+  if (win == nullptr || win->rootWindow == nil) {
+    return;
+  }
+  UIView *host = g_ghost_ios_host_view;
+  UIWindow *sceneWindow = (host != nil) ? host.window : nil;
+  UIWindowScene *scene = (sceneWindow != nil) ? sceneWindow.windowScene : nil;
+  if (scene == nil) {
+    scene = ghost_ios_pick_active_window_scene();
+  }
+  if (scene != nil && win->rootWindow.windowScene != scene) {
+    win->rootWindow.windowScene = scene;
