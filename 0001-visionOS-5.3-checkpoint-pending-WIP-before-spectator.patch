+#ifdef WITH_APPLE_CROSSPLATFORM
+/**
+ * App Store packaging gzips CPython dynload modules (`math.cpython-*.so.gz`).
+ * sitecustomize cannot `import gzip` until zlib itself is extracted, so do that
+ * in C before #Py_InitializeFromConfig and put the files first on PYTHONPATH.
+ * Simulator builds skip gzip, so this is a no-op there.
+ */
+static bool bpy_apple_extract_python_dynload(const char *python_home,
+                                             char *r_dir,
+                                             size_t r_dir_max)
+{
+  r_dir[0] = '\0';
+  if (python_home == nullptr || python_home[0] == '\0') {
+    return false;
+  }
+
+  char ver[32];
+  SNPRINTF(ver, "python%d.%d", PY_MAJOR_VERSION, PY_MINOR_VERSION);
+  char dynload[FILE_MAX];
+  BLI_path_join(dynload, sizeof(dynload), python_home, "lib", ver, "lib-dynload");
+  if (!BLI_is_dir(dynload)) {
+    return false;
+  }
+
+  char dest[FILE_MAX];
+  dest[0] = '\0';
+  if (const std::optional<std::string> user_dir = BKE_appdir_folder_id_create(
+          BLENDER_USER_DATAFILES, "python_dynload"))
+  {
+    BLI_strncpy(dest, user_dir->c_str(), sizeof(dest));
+  }
+  else {
+    BLI_path_join(dest, sizeof(dest), BKE_tempdir_base(), "python_dynload");
+    BLI_dir_create_recursive(dest);
+  }
+  if (dest[0] == '\0' || !BLI_is_dir(dest)) {
+    return false;
+  }
+
+  direntry *filelist = nullptr;
+  const uint n = BLI_filelist_dir_contents(dynload, &filelist);
+  uint extracted = 0;
+  uint reused = 0;
+  uint failed = 0;
+  for (uint i = 0; i < n; i++) {
+    const char *rel = filelist[i].relname;
+    if (rel == nullptr || !BLI_str_endswith(rel, ".so.gz")) {
+      continue;
+    }
+    char src[FILE_MAX];
+    char dst[FILE_MAX];
+    char out_name[FILE_MAXFILE];
+    BLI_path_join(src, sizeof(src), dynload, rel);
+    BLI_strncpy(out_name, rel, sizeof(out_name));
+    const size_t name_len = strlen(out_name);
+    if (name_len > 3) {
+      out_name[name_len - 3] = '\0';
+    }
+    BLI_path_join(dst, sizeof(dst), dest, out_name);
+    if (BLI_exists(dst) && !BLI_file_older(dst, src)) {
+      reused++;
+      continue;
+    }
+    if (BLI_file_ungzip(src, dst)) {
+      extracted++;
+    }
+    else {
+      failed++;
+    }
+  }
+  BLI_filelist_free(filelist, n);
+
+  fprintf(stderr,
+          "bpy: python dynload ungzip scanned=%u extracted=%u reused=%u failed=%u dir=%s\n",
+          n,
+          extracted,
+          reused,
+          failed,
+          dest);
+
+  if (extracted == 0 && reused == 0) {
+    return false;
+  }
+  BLI_strncpy(r_dir, dest, r_dir_max);
+  BLI_strncpy(bpy_apple_dynload_dir, dest, sizeof(bpy_apple_dynload_dir));
+  return true;
+}
+#endif
