+/*
+ * Apple View3D has no region overlap. WINDOW with ALIGN_NONE eats the remainder
+ * if it is not last, so TOOLS after it gets 0x0 (TOO_SMALL). Put WINDOW last
+ * (HUD stays after it) so HEADER / TOOLS / UI layout like desktop overlap.
+ */
+static void apple_touch_view3d_window_last(ListBaseT<ARegion> &regionbase)
+{
+  ARegion *window = nullptr;
+  ARegion *hud = nullptr;
+  for (ARegion &region : regionbase) {
+    if (region.regiontype == RGN_TYPE_WINDOW) {
+      window = &region;
+    }
+    else if (region.regiontype == RGN_TYPE_HUD) {
+      hud = &region;
+    }
+  }
+  if (window == nullptr) {
+    return;
+  }
+  if (hud != nullptr) {
+    if (window->next == hud) {
+      return;
+    }
+    BLI_remlink(&regionbase, window);
+    BLI_insertlinkbefore(&regionbase, hud, window);
+    return;
+  }
+  if (regionbase.last == window) {
+    return;
+  }
+  BLI_remlink(&regionbase, window);
+  BLI_addtail(&regionbase, window);
+}
