+  /* Context #Main can differ from #G_MAIN or list an empty `wm` after partial file setup. */
+  if (wm == nullptr && G_MAIN != nullptr && bmain != G_MAIN) {
+    wm = static_cast<wmWindowManager *>(G_MAIN->wm.first);
