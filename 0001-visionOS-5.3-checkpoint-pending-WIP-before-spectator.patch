 #include "BLI_fileops.hh"
 
+#include <cstdio>
+#include <zlib.h>
+
 #ifdef WIN32
 #  include "utfconv.hh"
 #endif
@@ -37,4 +40,41 @@ void fstream::open(StringRefNull filepath, ios_base::openmode mode)
 #endif
 }
 
+bool BLI_file_ungzip(const char *src_gz, const char *dst)
+{
+  gzFile gz = static_cast<gzFile>(BLI_gzopen(src_gz, "rb"));
+  if (gz == nullptr) {
+    return false;
+  }
+  FILE *out = BLI_fopen(dst, "wb");
+  if (out == nullptr) {
+    gzclose(gz);
+    return false;
+  }
+
+  char buf[1 << 16];
+  bool ok = true;
+  while (ok) {
+    const int n = gzread(gz, buf, sizeof(buf));
+    if (n < 0) {
+      ok = false;
+      break;
+    }
+    if (n == 0) {
+      break;
+    }
+    if (fwrite(buf, 1, size_t(n), out) != size_t(n)) {
+      ok = false;
+      break;
+    }
+  }
+
+  fclose(out);
+  gzclose(gz);
+  if (!ok) {
+    BLI_delete(dst, false, false);
+  }
+  return ok;
+}
+
 }  // namespace blender
