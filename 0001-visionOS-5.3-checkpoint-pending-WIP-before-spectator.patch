+/** visionOS keep-out for window-open interpolation (~500px). Do not cap the
+ * live drawable down to 1080p: that packed the factory layout into a 1920
+ * grid while the MTKView stayed 1280×720@2x (2560), so Outliner/Properties
+ * crushed and hit-tests missed. 5.0 TF-97 uses native pixels. Overlay.draw
+ * remains skipped; this only restores size/coords. */
+#if TARGET_OS_VISION
+static constexpr CGFloat GHOST_IOS_MAX_PIXEL_DIM = 8192.0;
+static constexpr CGFloat GHOST_IOS_MAX_PIXEL_DIM_H = 8192.0;
+static constexpr CGFloat GHOST_IOS_MIN_PIXEL_DIM = 960.0;
+static constexpr CGFloat GHOST_IOS_MIN_PIXEL_DIM_H = 540.0;
+static constexpr CGFloat GHOST_IOS_FALLBACK_PIXEL_W = 2560.0;
