diff --git a/intern/ghost/intern/immersive/BlenderImmersiveARKitHub.swift b/intern/ghost/intern/immersive/BlenderImmersiveARKitHub.swift
new file mode 100644
index 00000000000..a044a3862f1
--- /dev/null
+++ b/intern/ghost/intern/immersive/BlenderImmersiveARKitHub.swift
@@ -0,0 +1,64 @@
+/* SPDX-FileCopyrightText: 2026 Blender Authors
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later */
+
+/**
+ * One ARKitSession for Immersive Space.
+ *
+ * A second `ARKitSession.run` (WorldAnchor / hands / reconstruction on
+ * separate sessions) pauses providers started earlier. That left World Mesh
+ * with only the first Scene Reconstruction tile. All DataProviders that
+ * need World Sensing share this hub.
+ */
+
+import ARKit
+import Foundation
+
+#if os(visionOS)
+
+  @MainActor
+  enum BlenderImmersiveARKitHub {
+    static let session = ARKitSession()
+    static let worldTracking = WorldTrackingProvider()
+    static let sceneReconstruction = SceneReconstructionProvider(modes: [])
+
+    private static var running = false
+
+    /** Start World Tracking + Scene Reconstruction together (idempotent). */
+    static func ensureRunning() async -> Bool {
+      if running {
+        return true
+      }
+      guard SceneReconstructionProvider.isSupported else {
+        print("[immersive] ARKitHub: SceneReconstructionProvider not supported")
+        return false
+      }
+      let auth = await session.requestAuthorization(for: [.worldSensing])
+      if auth[.worldSensing] != .allowed {
+        print("[immersive] ARKitHub: World Sensing not allowed — \(auth)")
+        return false
+      }
+      do {
+        try await session.run([worldTracking, sceneReconstruction])
+        running = true
+        print("[immersive] ARKitHub: WorldTracking + SceneReconstruction running")
+        return true
+      }
+      catch {
+        print("[immersive] ARKitHub: session.run failed: \(error)")
+        return false
+      }
+    }
+
+    static func stop() {
+      running = false
+      Task {
+        /* run([]) stops every provider on this session (ARKitSession has no
+         * public stop() that keeps reconstruction alive). */
+        try? await session.run([])
+        print("[immersive] ARKitHub: stopped")
+      }
+    }
+  }
+
+#endif
