+static void ghost_ios_apply_host_resize(GHOST_WindowIOS *win, CGRect bounds, CGSize px)
+{
+  GHOST_SystemIOS *system = static_cast<GHOST_SystemIOS *>(GHOST_ISystem::getSystem());
+  if (system == nullptr || win == nullptr || win->rootWindow == nil) {
+    return;
+  }
+  win->rootWindow.frame = bounds;
+  s_ghost_ios_applied_first_size = true;
+  s_ghost_ios_last_applied_px = px;
+  s_ghost_ios_settle_size = px;
+  s_ghost_ios_settle_t = CACurrentMediaTime();
+  char buf[128];
+  snprintf(buf, sizeof(buf), "ghost: live resize applied %.0fx%.0f", px.width, px.height);
+  GHOST_IOS_diag_log(buf);
+  system->handleWindowEvent(GHOST_kEventWindowSize, win);
+  win->needsDisplayUpdate();
+}
