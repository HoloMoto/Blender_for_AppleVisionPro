+def _apple_ensure_anim_keymap(slog=None):
+    """5.0 default keymap binds TIMER0 to screen.animation_step. visionOS
+    keyconfig was missing that item, so playback never advanced cfra."""
+    global _APPLE_KM_DUMPED
+    wm = bpy.context.window_manager
+    if slog is not None and not _APPLE_KM_DUMPED:
+        _APPLE_KM_DUMPED = True
+        for kc in (
+            wm.keyconfigs.default,
+            wm.keyconfigs.addon,
+            wm.keyconfigs.user,
+            wm.keyconfigs.active,
+        ):
+            if kc is None:
+                slog("[keymap] kc=None")
+                continue
+            km_s = kc.keymaps.get("Screen")
+            km_v = kc.keymaps.get("3D View")
+            slog(
+                f"[keymap] {kc.name} maps={len(kc.keymaps)}"
+                f" screen={len(km_s.keymap_items) if km_s else -1}"
+                f" view3d={len(km_v.keymap_items) if km_v else -1}"
+                f" total_items={sum(len(km.keymap_items) for km in kc.keymaps)}"
+                f" nonempty={sum(1 for km in kc.keymaps if km.keymap_items)}"
+            )
+        default = wm.keyconfigs.default
+        km_s = default.keymaps.get("Screen") if default else None
+        total = sum(len(km.keymap_items) for km in default.keymaps) if default else 0
+        try:
+            import bpy.utils as bu
+            preset = bu.preset_find("Blender", "keyconfig")
+            slog(f"[keymap] preset_find={preset} script_paths={list(bu.script_paths())}")
+        except Exception as ex:
+            slog(f"[keymap] preset_find_fail {ex}")
+            preset = None
+        if total < 100:
+            slog(f"[keymap] default too small total={total}, keyconfig_init/set")
+            try:
+                bpy.utils.keyconfig_init()
+            except Exception as ex:
+                slog(f"[keymap] keyconfig_init_fail {ex}")
+            if preset:
+                try:
+                    bpy.utils.execfile(preset)
+                    slog("[keymap] execfile Blender.py done")
+                except Exception:
+                    import traceback
+                    slog("[keymap] execfile Blender.py fail")
+                    slog(traceback.format_exc())
+                try:
+                    ok = bpy.utils.keyconfig_set(preset)
+                    slog(f"[keymap] keyconfig_set ok={ok}")
+                except Exception as ex:
+                    slog(f"[keymap] keyconfig_set_fail {ex}")
+            default = wm.keyconfigs.default
+            slog(
+                f"[keymap] after-reload maps={len(default.keymaps) if default else -1}"
+                f" total={sum(len(km.keymap_items) for km in default.keymaps) if default else -1}"
+            )
+    added = 0
+    for kc in (wm.keyconfigs.default, wm.keyconfigs.addon, wm.keyconfigs.user, wm.keyconfigs.active):
+        if kc is None:
+            continue
+        km = kc.keymaps.get("Screen")
+        if km is None:
+            continue
+        for idname, etype in (
+            ("screen.animation_step", "TIMER0"),
+            ("screen.region_blend", "TIMERREGION"),
+        ):
+            if any(item.idname == idname for item in km.keymap_items):
+                continue
+            km.keymap_items.new(idname, type=etype, value='ANY', any=True)
+            added += 1
+    if slog is not None and added:
+        slog(f"[anim] injected animation_step keymap n={added}")
+
