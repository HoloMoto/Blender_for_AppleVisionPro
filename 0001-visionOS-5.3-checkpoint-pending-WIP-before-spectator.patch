+/* Opening interpolation must not reflow Blender. After the first real size,
+ * follow the volume live the way 5.0 does — waiting 0.20s never fired while
+ * the user kept grabbing, so View3D stayed at the open texture. */
+static void ghost_ios_maybe_queue_settled_resize(GHOST_WindowIOS *win)
+{
+#if TARGET_OS_VISION
+  if (win == nullptr || win->rootWindow == nil || g_ghost_ios_host_view == nil) {
+    return;
+  }
+  UIWindow *hostWin = g_ghost_ios_host_view.window;
+  if (hostWin == nil) {
+    return;
+  }
+  const CGRect bounds = hostWin.bounds;
+  if (bounds.size.width < 8.0 || bounds.size.height < 8.0) {
+    return;
+  }
+  const CGFloat scale = ghost_ios_display_scale(g_ghost_ios_host_view);
+  const CGSize px = CGSizeMake(bounds.size.width * scale, bounds.size.height * scale);
+  if (ghost_ios_host_px_too_small_for_layout(px)) {
+    return;
+  }
+  if (s_ghost_ios_applied_first_size &&
+      ghost_ios_size_px_close(s_ghost_ios_last_applied_px, px, 16.0))
+  {
+    if (!CGRectEqualToRect(win->rootWindow.frame, bounds)) {
+      win->rootWindow.frame = bounds;
+    }
+    return;
+  }
+  if (s_ghost_ios_applied_first_size) {
+    ghost_ios_apply_host_resize(win, bounds, px);
+    return;
+  }
+  if (!ghost_ios_size_is_settled(px)) {
+    return;
+  }
+  static bool s_queued = false;
+  if (s_queued) {
+    return;
+  }
+  s_queued = true;
+  GHOST_WindowIOS *held = win;
+  dispatch_async(dispatch_get_main_queue(), ^{
+    s_queued = false;
+    GHOST_SystemIOS *system = static_cast<GHOST_SystemIOS *>(GHOST_ISystem::getSystem());
+    if (system == nullptr || system->current_active_window_ != held || held->rootWindow == nil) {
+      return;
+    }
+    UIWindow *host = (g_ghost_ios_host_view != nil) ? g_ghost_ios_host_view.window : nil;
+    if (host == nil) {
+      return;
+    }
+    const CGRect latest = host.bounds;
+    if (latest.size.width < 8.0 || latest.size.height < 8.0) {
+      return;
+    }
+    const CGFloat sc = ghost_ios_display_scale(g_ghost_ios_host_view);
+    const CGSize px2 = CGSizeMake(latest.size.width * sc, latest.size.height * sc);
+    if (ghost_ios_host_px_too_small_for_layout(px2)) {
+      return;
+    }
+    ghost_ios_apply_host_resize(held, latest, px2);
+  });
+#else
+  (void)win;
+#endif
+}
