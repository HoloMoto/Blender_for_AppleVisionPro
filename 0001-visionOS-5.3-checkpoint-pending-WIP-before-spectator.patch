+  const kern_return_t kr = task_info(
+      mach_task_self(), TASK_VM_INFO, (task_info_t)&info, &count);
+  *footprint_mb =
+      (kr == KERN_SUCCESS) ? (double(info.phys_footprint) / (1024.0 * 1024.0)) : -1.0;
+  *avail_mb = -1.0;
+  if (@available(iOS 13.0, visionOS 1.0, *)) {
+    *avail_mb = double(os_proc_available_memory()) / (1024.0 * 1024.0);
+  }
