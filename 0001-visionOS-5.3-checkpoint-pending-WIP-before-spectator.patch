+static PyObject *bpy_app_visionos_world_mesh_copy(PyObject * /*self*/, PyObject *args)
+{
+#ifdef WITH_APPLE_CROSSPLATFORM
+  unsigned int max_verts = BLENDER_VISIONOS_WORLD_MESH_MAX_VERTS;
+  unsigned int max_indices = BLENDER_VISIONOS_WORLD_MESH_MAX_INDICES;
+  if (!PyArg_ParseTuple(args, "|II", &max_verts, &max_indices)) {
+    return nullptr;
+  }
+  max_verts = std::min(max_verts, BLENDER_VISIONOS_WORLD_MESH_MAX_VERTS);
+  max_indices = std::min(max_indices, BLENDER_VISIONOS_WORLD_MESH_MAX_INDICES);
+  if (max_verts == 0) {
+    max_verts = 1;
+  }
+  if (max_indices == 0) {
+    max_indices = 1;
+  }
+
+  std::vector<float> xyz(size_t(max_verts) * 3u);
+  std::vector<uint32_t> indices(max_indices);
+  uint32_t vcount = 0;
+  uint32_t icount = 0;
+  const int ok = BLENDER_VISIONOS_world_mesh_copy(
+      xyz.data(), max_verts, &vcount, indices.data(), max_indices, &icount);
+  const uint32_t nverts = std::min(vcount, max_verts);
+  const uint32_t nidx = std::min(icount, max_indices);
+
+  PyObject *py_xyz = PyList_New(nverts * 3);
+  if (py_xyz == nullptr) {
+    return nullptr;
+  }
+  for (uint32_t i = 0; i < nverts * 3; i++) {
+    PyList_SET_ITEM(py_xyz, i, PyFloat_FromDouble(xyz[i]));
+  }
+  PyObject *py_idx = PyList_New(nidx);
+  if (py_idx == nullptr) {
+    Py_DECREF(py_xyz);
+    return nullptr;
+  }
+  for (uint32_t i = 0; i < nidx; i++) {
+    PyList_SET_ITEM(py_idx, i, PyLong_FromUnsignedLong(indices[i]));
+  }
+  return Py_BuildValue("{s:i,s:I,s:I,s:N,s:N}",
+                       "ok",
+                       ok,
+                       "vertex_count",
+                       vcount,
+                       "index_count",
+                       icount,
+                       "xyz",
+                       py_xyz,
+                       "indices",
+                       py_idx);
+#else
+  (void)args;
+  Py_RETURN_NONE;
+#endif
+}
