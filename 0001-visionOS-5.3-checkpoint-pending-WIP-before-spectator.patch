+static void ghost_ios_sync_ghost_window_frame(GHOST_WindowIOS *win)
+{
+  UIWindow *hostWin = (g_ghost_ios_host_view != nil) ? g_ghost_ios_host_view.window : nil;
+  if (hostWin == nil || win == nullptr || win->rootWindow == nil) {
+    return;
+  }
+  const CGRect bounds = hostWin.bounds;
+  if (bounds.size.width < 8.0 || bounds.size.height < 8.0) {
+    return;
+  }
+#if TARGET_OS_VISION
+  /* Frame copy without WindowSize left Blender at the first size (5.0 does both). */
+  ghost_ios_maybe_queue_settled_resize(win);
+  return;
+#else
+  const CGFloat scale = ghost_ios_display_scale(g_ghost_ios_host_view);
+  const CGSize px = CGSizeMake(bounds.size.width * scale, bounds.size.height * scale);
+  if (ghost_ios_pixel_size_too_small(px.width, px.height)) {
+    return;
+  }
+  if (!CGRectEqualToRect(win->rootWindow.frame, bounds)) {
+    win->rootWindow.frame = bounds;
+  }
+#endif
+}
