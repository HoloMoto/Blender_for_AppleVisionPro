-static float4 calculate_catmull_rom_basis_derivative(const float parameter)
-{
-  const float t = parameter;
-  const float s = 1.0f - parameter;
-  return {
-      s * (3.0f * t - 1.0f),
-      9.0f * t * t - 10.0f * t,
-      10.0f * s - 9.0f * s * s,
-      t * (3.0f * t - 2.0f),
-  };
-}
