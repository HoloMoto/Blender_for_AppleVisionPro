+                       RGN_FLAG_POLL_FAILED);
+      region.alignment = RGN_ALIGN_LEFT;
+      region.sizex = short(UI_TOOLBAR_WIDTH);
+    }
+  }
+  if (spacetype == SPACE_VIEW3D) {
+    apple_touch_view3d_window_last(regionbase);
+  }
