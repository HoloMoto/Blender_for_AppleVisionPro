+/**
+ * Factory layouts store a ~1-header timeline. At visionOS DPI that leaves the WINDOW
+ * 0–2 px tall. Node/Text editors in other workspaces can collapse the same way.
+ *
+ * Area v2–v3 / v4–v1 is often split by a T-junction, so BKE_screen_find_edge
+ * returns null and the sliver stays 7 px. Pick any colinear horizontal edge
+ * that overlaps the area; select_connected_edge then floods the whole row.
+ */
+static ScrEdge *screen_geom_apple_find_horizontal_edge(const bScreen *screen,
+                                                       const ScrArea *area,
+                                                       const short y)
+{
+  const short xmin = std::min(area->v1->vec.x, area->v4->vec.x);
+  const short xmax = std::max(area->v1->vec.x, area->v4->vec.x);
+  for (ScrEdge &se : screen->edgebase) {
+    if (!screen_geom_edge_is_horizontal(&se)) {
+      continue;
+    }
+    if (se.v1->vec.y != y) {
+      continue;
+    }
+    const short ex0 = std::min(se.v1->vec.x, se.v2->vec.x);
+    const short ex1 = std::max(se.v1->vec.x, se.v2->vec.x);
+    if (ex1 <= xmin || ex0 >= xmax) {
+      continue;
+    }
+    return &se;
+  }
+  return nullptr;
+}
+
+static int screen_geom_apple_area_min_height(const ScrArea *area, const rcti *screen_rect)
+{
+  const int header = ED_area_headersize();
+  const int border = int(ceil(float(U.border_width) * UI_SCALE_FAC));
+  const int screen_h = BLI_rcti_size_y(screen_rect) + 1;
+  int min = header + border;
+  switch (area->spacetype) {
+    case SPACE_ACTION:
+      /* Header + scrub + a few channel rows. Do not steal a third of the
+       * screen when a usable Dope Sheet already exists beside the sliver. */
+      min = header * 5 + border;
+      min = std::min(min, std::max(header * 3, screen_h / 4));
+      break;
+    case SPACE_NODE:
+    case SPACE_TEXT:
+    case SPACE_CONSOLE:
+    case SPACE_INFO:
+    case SPACE_IMAGE:
+    case SPACE_GRAPH:
+    case SPACE_NLA:
+    case SPACE_SEQ:
+    case SPACE_SPREADSHEET:
+      min = header * 5 + border;
+      min = std::min(min, std::max(header * 3, screen_h / 3));
+      break;
+    case SPACE_VIEW3D:
+      min = header * 6 + border;
+      break;
+    case SPACE_OUTLINER:
+    case SPACE_PROPERTIES:
+      min = header * 4 + border;
+      break;
+    default:
+      break;
+  }
+  return min;
+}
+
+static bool screen_geom_apple_apply_min_heights(const wmWindow *win,
+                                                const bScreen *screen,
+                                                const rcti *screen_rect)
+{
+  bool needs_another_pass = false;
+  for (ScrArea &area : screen->areabase) {
+    const int min = screen_geom_apple_area_min_height(&area, screen_rect);
+    const int height = screen_geom_area_height(&area);
+    if (height >= min || area.v1 == area.v2) {
+      continue;
+    }
+    const bool at_bottom = area.v1->vec.y <= screen_rect->ymin + 1;
+    ScrEdge *se = at_bottom ? BKE_screen_find_edge(screen, area.v2, area.v3) :
+                              BKE_screen_find_edge(screen, area.v4, area.v1);
+    if (se == nullptr) {
+      se = at_bottom ? BKE_screen_find_edge(screen, area.v4, area.v1) :
+                       BKE_screen_find_edge(screen, area.v2, area.v3);
+    }
+    if (se == nullptr) {
+      const short y = at_bottom ? area.v2->vec.y : area.v1->vec.y;
+      se = screen_geom_apple_find_horizontal_edge(screen, &area, y);
+    }
+    if (se == nullptr) {
+      static int s_miss_n = 0;
+      if (s_miss_n++ < 8) {
+        char buf[192];
+        snprintf(buf,
+                 sizeof(buf),
+                 "apple layout miss space=%d h=%d min=%d y1=%d y2=%d",
+                 int(area.spacetype),
+                 height,
+                 min,
+                 int(area.v1->vec.y),
+                 int(area.v2->vec.y));
+        GHOST_IOS_diag_log(buf);
+      }
+      continue;
+    }
+    int yval = at_bottom ? (area.v1->vec.y + min - 1) : (area.v2->vec.y - min);
+    if (at_bottom) {
+      yval = std::min(yval, int(screen_rect->ymax - 2));
+    }
+    else {
+      yval = std::max(yval, int(screen_rect->ymin));
+    }
+    screen_geom_select_connected_edge(win, se);
+    for (ScrVert &sv : screen->vertbase) {
+      if (sv.flag == 0) {
+        continue;
+      }
+      if (at_bottom) {
+        if (ELEM(&sv, area.v1, area.v4)) {
+          continue;
+        }
+      }
+      else if (ELEM(&sv, area.v2, area.v3)) {
+        continue;
+      }
+      if (sv.vec.y != yval) {
+        sv.vec.y = short(yval);
+        needs_another_pass = true;
+      }
+    }
+  }
+  for (ScrArea &area : screen->areabase) {
+    const int height = screen_geom_area_height(&area);
+    if (height > 0 && height < 24) {
+      static int s_sliver_n = 0;
+      if (s_sliver_n++ < 12) {
+        char buf[192];
+        snprintf(buf,
+                 sizeof(buf),
+                 "apple layout sliver space=%d h=%d min=%d",
+                 int(area.spacetype),
+                 height,
+                 screen_geom_apple_area_min_height(&area, screen_rect));
+        GHOST_IOS_diag_log(buf);
+      }
+    }
+  }
+  return needs_another_pass;
+}
