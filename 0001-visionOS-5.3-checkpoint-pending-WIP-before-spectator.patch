+  /* TF-97: do not copy SwiftUI WindowGroup.bounds onto GHOST. GHOST sizes
+   * itself from createWindow / scene bounds; makeKeyAndVisible puts it in front. */
+  win->rootWindow.windowLevel = UIWindowLevelNormal;
+  win->rootWindow.hidden = NO;
+  win->rootWindow.userInteractionEnabled = YES;
+  UIView *ghostView = win->getView();
+  if (ghostView != nil) {
+    ghostView.userInteractionEnabled = YES;
+    ghostView.multipleTouchEnabled = YES;
+  }
+  [win->rootWindow makeKeyAndVisible];
+  GHOST_IOS_diag_log("ghost: GHOST window bound to SwiftUI scene");
+}
