+static constexpr CGFloat GHOST_IOS_MAX_PIXEL_DIM_H = 8192.0;
+static constexpr CGFloat GHOST_IOS_MIN_PIXEL_DIM = 8.0;
+static constexpr CGFloat GHOST_IOS_MIN_PIXEL_DIM_H = 8.0;
+static constexpr CGFloat GHOST_IOS_FALLBACK_PIXEL_W = 1920.0;
+static constexpr CGFloat GHOST_IOS_FALLBACK_PIXEL_H = 1080.0;
+#endif
+
+static inline bool ghost_ios_size_is_usable(CGFloat width, CGFloat height)
+{
+  return std::isfinite(double(width)) && std::isfinite(double(height)) && width > 1.0 &&
+         height > 1.0;
+}
+
+static inline bool ghost_ios_pixel_size_too_small(CGFloat width, CGFloat height)
+{
+  return width + 0.5 < GHOST_IOS_MIN_PIXEL_DIM || height + 0.5 < GHOST_IOS_MIN_PIXEL_DIM_H;
+}
+
+static inline CGSize ghost_ios_clamp_pixel_size(CGFloat width, CGFloat height)
+{
+  static CGSize last_good = {GHOST_IOS_FALLBACK_PIXEL_W, GHOST_IOS_FALLBACK_PIXEL_H};
+  if (!ghost_ios_size_is_usable(width, height)) {
+    return last_good;
+  }
+  CGSize sized;
+  if (width <= GHOST_IOS_MAX_PIXEL_DIM && height <= GHOST_IOS_MAX_PIXEL_DIM_H) {
+    sized = CGSizeMake(width, height);
+  }
+  else {
+    const CGFloat scale = fmin(GHOST_IOS_MAX_PIXEL_DIM / width, GHOST_IOS_MAX_PIXEL_DIM_H / height);
+    sized = CGSizeMake(floor(width * scale), floor(height * scale));
+  }
+  if (ghost_ios_pixel_size_too_small(sized.width, sized.height)) {
+    return last_good;
+  }
+  if (fabs(sized.width - last_good.width) < 8.0 && fabs(sized.height - last_good.height) < 8.0) {
+    return last_good;
+  }
+  last_good = sized;
+  return sized;
