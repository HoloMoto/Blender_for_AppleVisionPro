+/**
+ * visionOS DPI + no region overlap: factory startup keeps a TOOL_HEADER (and the Top-bar
+ * tool-settings WINDOW) that draws as an empty black strip. Hide those regions so File sits
+ * on the 3D header, and so timelines keep their WINDOW instead of header+footer only.
+ */
+static void apple_touch_hide_regions(ListBaseT<ARegion> &regionbase, const int spacetype)
+{
+  for (ARegion &region : regionbase) {
+    if (region.regiontype == RGN_TYPE_TOOL_HEADER) {
+      region.flag |= RGN_FLAG_HIDDEN | RGN_FLAG_HIDDEN_BY_USER;
+    }
+    if (ELEM(region.regiontype, RGN_TYPE_ASSET_SHELF, RGN_TYPE_ASSET_SHELF_HEADER)) {
+      region.flag |= RGN_FLAG_HIDDEN | RGN_FLAG_HIDDEN_BY_USER;
+    }
+    if (spacetype == SPACE_TOPBAR && region.regiontype == RGN_TYPE_WINDOW) {
+      region.flag |= RGN_FLAG_HIDDEN | RGN_FLAG_HIDDEN_BY_USER;
+    }
+    if (spacetype == SPACE_ACTION && ELEM(region.regiontype, RGN_TYPE_FOOTER, RGN_TYPE_UI)) {
+      region.flag |= RGN_FLAG_HIDDEN | RGN_FLAG_HIDDEN_BY_USER;
+    }
+    if (spacetype == SPACE_ACTION && region.regiontype == RGN_TYPE_CHANNELS) {
+      region.flag &= ~(RGN_FLAG_HIDDEN | RGN_FLAG_HIDDEN_BY_USER);
+    }
+    /* 5.0 factory View3D keeps the left tool strip (Select / Move / Rotate).
+     * 5.3 startup.blend hides RGN_TYPE_TOOLS. prefsizex is one icon column. */
+    if (spacetype == SPACE_VIEW3D && region.regiontype == RGN_TYPE_TOOLS) {
