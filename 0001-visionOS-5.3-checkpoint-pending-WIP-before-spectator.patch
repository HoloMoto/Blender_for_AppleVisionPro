+void GHOST_ContextIOS::metalPresentLastOverlay()
+{
+  if (metal_view_ == nil || contextPresentCallback == nullptr) {
+    return;
+  }
+
+  id<MTLTexture> last = nil;
+  const unsigned prev = (current_swapchain_index + METAL_SWAPCHAIN_SIZE - 1) % METAL_SWAPCHAIN_SIZE;
+  if (m_defaultFramebufferMetalTexture[prev].texture != nil) {
+    last = m_defaultFramebufferMetalTexture[prev].texture;
+  }
+  else if (m_defaultFramebufferMetalTexture[current_swapchain_index].texture != nil) {
+    last = m_defaultFramebufferMetalTexture[current_swapchain_index].texture;
+  }
+  if (last == nil) {
+    return;
+  }
+
+  const CGSize drawable = metal_view_.drawableSize;
+  if (last.width != NSUInteger(drawable.width) || last.height != NSUInteger(drawable.height)) {
+    /* Resize: never blit a stale overlay onto a new drawable (Build 45 crash). */
+    metalUpdateFramebuffer();
+    return;
+  }
+
+  @autoreleasepool {
+    MTLRenderPassDescriptor *passDescriptor = metal_view_.currentRenderPassDescriptor;
+    if (passDescriptor == nil) {
+      return;
+    }
+    id<CAMetalDrawable> current_drawable = metal_view_.currentDrawable;
+    if (current_drawable == nil) {
+      return;
+    }
+    if (current_drawable == GHOST_ContextIOS::prevDrawable && current_drawable_presented) {
+      return;
+    }
+    GHOST_ContextIOS::prevDrawable = current_drawable;
+    GHOST_ContextIOS::current_drawable_presented = false;
+    (*contextPresentCallback)(passDescriptor,
+                              (id<MTLRenderPipelineState>)metal_render_pipeline_,
+                              last,
+                              current_drawable);
+    GHOST_ContextIOS::current_drawable_presented = true;
   }
 }
